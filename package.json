{
  "name": "metallix-pocket-model",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:demo": "node scripts/demo/build-demo.mjs",
    "demo:snapshots": "tsx scripts/demo/generate-demo-snapshots.mjs",
    "demo:snapshots:determinism": "tsx scripts/demo/generate-demo-snapshots.mjs --determinism",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src server.ts routes server tests",
    "check:bundle": "vite build && node scripts/check-bundle-size.mjs",
    "test:unit": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=src/utils/** tests/*.test.ts tests/*.test.tsx",
    "sbom": "python python/generate_sbom.py",
    "test:lpbf": "python python/test_lpbf_build_job.py",
    "test:lpbf:engineering": "python python/test_lpbf_engineering.py",
    "test:lpbf:api": "python python/test_lpbf_api.py",
    "test:lpbf:slow": "python python/test_lpbf_build_job.py --slow",
    "lpbf:calibration": "python -B python/tools/lpbf_calibration_fit.py --table-cache .runtime/cache/lpbf_calib_table.json --jobs 12",
    "lpbf:calibration:check": "python -B python/tools/lpbf_calibration_fit.py --check",
    "lpbf:calibration:v2": "python -B python/tools/lpbf_calibration_fit_v2.py --table-cache .runtime/cache/lpbf_calib_table.json --jobs 12",
    "lpbf:calibration:v2:check": "python -B python/tools/lpbf_calibration_fit_v2.py --check",
    "lpbf:bands": "python -B python/tools/lpbf_error_bands.py",
    "lpbf:bands:check": "python -B python/tools/lpbf_error_bands.py --check",
    "test:meltpool": "python python/test_eagar_tsai.py && python python/test_goldak_fabbro.py && python python/test_lpbf_meltpool_accuracy.py"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@react-three/drei": "^9.109.2",
    "@react-three/fiber": "^8.16.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "0.16.11",
    "leva": "^0.10.1",
    "lucide-react": "^0.546.0",
    "plotly.js-dist-min": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "0.16.7",
    "@types/node": "^22.14.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
