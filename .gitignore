node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
__pycache__/
*.pyc
*.pyo
.lpbf-jobs/
.research-registry/
python/openfoam/Make/linux*/
python/openfoam/bin/

# Local benchmark payloads; commit small provenance manifests, not raw measurements.
data/benchmark/**/raw/
# Default download directory of python/tools/fetch_external_data.py (external-data-manifest.json).
/external-data/
.runtime/

# Graft keeps durable markdown wiring cards in source control; these are
# machine-local indexes and caches rebuilt with `graft build`.
graft/.cache/
graft/.graph/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local LPBF source archive bytes and SQLite metadata
.lpbf-sources/
.lpbf-surrogates/
.lpbf-runs/
.lpbf-run-bundles/

# Local LPBF validation outputs and GPU compiler caches; provenance lives in docs.
/.tmp-lpbf-*/
/.tmp-phase22-*/
/python/.tmp-*/
/python/.warp-cache/

# Orchestra shared state (agent coordination, local only)
/.orchestra/


# Local runtime state and test temp directories (not evidence)
/server/graft/
/.npm-cache/
/tmp*/
/python/python/
/python/codex-lpbf-test-tmp/
/python/lpbf-run-shape-*/
docs/**/queue.sqlite
docs/**/worker.lock
# Orchestra lane run roots (local logs and scratch artifacts)
/.orchestra-run/

# Local AI-assistant tooling (kept on disk, not part of the product)
.agents/
.cursor/
.gemini/

# Static demo build output
dist-demo/

# Local source archive: commit INDEX/hash manifests, never PDF bytes.
/papers/**/*.[pP][dD][fF]
# Local-only SOL-C source copies (lawfully downloaded, never redistributed); papers/INDEX.md stays tracked.
/papers/solc_a6_*
/papers/solc_a7_*
/papers/mizukami2020_solc_*
/papers/sol_c_*
